generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Sucursal {
  id           Int          @id
  codigo       String       @unique
  nombre       String
  rackAsignado String       @unique
  bultos       Bulto[]
  embarques    Embarque[]
  lineasOC     LineaOC[]
}

model Proveedor {
  idProveedor   Int           @id @default(autoincrement())
  nombre        String        @unique
  correo        String        @unique
  password      String
  productos     Producto[]
  ordenesCompra OrdenCompra[]
}

model Producto {
  sku               String    @id
  idProveedor       Int
  descripcion       String
  pesoUnitarioKg    Float
  volumenUnitarioM3 Float
  proveedorRel      Proveedor @relation(fields: [idProveedor], references: [idProveedor])
}

model OrdenCompra {
  idOc         String       @id
  idProveedor  Int
  fechaEmision DateTime     @default(now())
  estado       String       @default("PENDIENTE")
  proveedorRel Proveedor    @relation(fields: [idProveedor], references: [idProveedor])
  lineas       LineaOC[]
  citaFactura  CitaFactura?
  bultos       Bulto[]
}

model LineaOC {
  id            Int         @id @default(autoincrement())
  idOc          String
  sku           String
  descripcion   String
  sucursalId    Int
  piezasPedidas Int
  ordenCompra   OrdenCompra @relation(fields: [idOc], references: [idOc])
  sucursal      Sucursal    @relation(fields: [sucursalId], references: [id])
}

model CitaFactura {
  id            Int         @id @default(autoincrement())
  idOc          String      @unique
  folioFactura  String      @unique
  proveedor     String
  anden         Int
  fecha         String
  horaInicio    Int
  duracionHoras Int
  estado        String      @default("PROGRAMADA")
  ordenCompra   OrdenCompra @relation(fields: [idOc], references: [idOc])
  bultos        Bulto[]
}

model Bulto {
  idBulto       String       @id
  folioFactura  String
  idOc          String
  proveedor     String
  sucursalId    Int
  sku           String
  descripcion   String       @default("")
  piezas        Int
  pesoKg        Float
  volumenM3     Float
  /// Altura del bulto en metros (para validar contra altura útil de tarima).
  altoM         Float?
  /// Posición en rack: nivel 1 (piso) a 4. Null = aún no acomodado.
  nivel         Int?
  /// Posición en rack: columna 1 (cerca salida) a 8. Null = aún no acomodado.
  columna       Int?
  /// Demanda de embarque: "alta" | "media" | "baja" (define zona sugerida A/B/C).
  demandaEmbarque String     @default("media")
  estado        String       @default("PENDIENTE_RECIBO")
  motivoRechazo String?
  embarqueId    String?
  citaFactura   CitaFactura  @relation(fields: [folioFactura], references: [folioFactura])
  ordenCompra   OrdenCompra  @relation(fields: [idOc], references: [idOc])
  sucursal      Sucursal     @relation(fields: [sucursalId], references: [id])
  embarque      Embarque?    @relation(fields: [embarqueId], references: [idEmbarque])
}

model Embarque {
  idEmbarque        String   @id
  sucursalId        Int
  andenSalida       Int
  pesoTotalKg       Float
  volumenTotalM3    Float
  porcentajePeso    Float
  porcentajeVolumen Float
  fechaSalida       DateTime @default(now())
  sucursal          Sucursal @relation(fields: [sucursalId], references: [id])
  bultos            Bulto[]
}
